# Core app settings
APP_NAME=hotel-delivery-robot
APP_ENV=development
DATABASE_URL=sqlite:///./backend/data/hotel.db
BACKEND_PORT=8000
FRONTEND_PORT=5173
LOG_LEVEL=INFO

# Optional external adapters
TELEPHONY_PROVIDER=mock
ROBOT_ADAPTER=mock
MODEL_PROVIDER=mock

# Frontend runtime URL; leave blank to use the default same-origin dev proxy.
VITE_API_BASE_URL=http://localhost:8000
