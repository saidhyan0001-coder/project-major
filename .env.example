# Core app settings
APP_NAME=willow-hotel-ordering
APP_ENV=development
DATABASE_URL=sqlite:///./hotel.db
BACKEND_PORT=8000
FRONTEND_PORT=5173
LOG_LEVEL=INFO

# Set LLM_PROVIDER=gemini after supplying a valid key and available model.
# mock is a local deterministic demo only; it does not call a hosted LLM.
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=15

# Generate long random values and keep them only in backend environment secrets.
STAFF_API_TOKEN=
APRILTAG_REPORT_TOKEN=
API_RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public backend URL only; never put credentials or private keys in VITE_* variables.
VITE_API_BASE_URL=http://localhost:8000
